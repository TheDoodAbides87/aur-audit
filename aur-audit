#!/usr/bin/python3 -I
"""
aur-audit: security audit for AUR packages, run as a pacman PreTransaction hook.

Modes:
  aur-audit --hook             Called by pacman. Reads target names on stdin.
  aur-audit dir BUILDDIR       Audit a PKGBUILD directory before makepkg touches it
                               (used by the aur-audit-makepkg wrapper for yay).
  aur-audit check PKG...       Audit AUR packages by name BEFORE building them.
  aur-audit file PKGFILE...    Audit already-built package files.
  aur-audit ai PKG|DIR         Ask your AI assistant whether a blocked package is
                               actually malicious (optional; never unblocks anything).
  aur-audit ai --installed PKG Ask your AI assistant to review a package you
                               already have installed (AUR or official repos).
  aur-audit system             Check this system for signs of malware (free, no AI).
  aur-audit ai --system        The same, then (after showing the estimated token
                               cost and asking) have your AI assistant review it.

Exit status 1 means at least one BLOCK finding was not allowlisted. In hook
mode, pacman's AbortOnFail turns that into a cancelled transaction.
"""

import hashlib
import ipaddress
import json
import os
import pwd
import shutil
import stat
import re
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.parse
import urllib.request

AUR = "https://aur.archlinux.org"
ALLOWLIST = "/etc/aur-audit/allowlist"
TIMEOUT = 15
DAY = 86400

BLOCK, WARN, INFO = "BLOCK", "WARN", "INFO"


# ---------------------------------------------------------------- helpers

def http_get(url, accept=None):
    headers = {"User-Agent": "aur-audit/1.0"}
    if accept:
        headers["Accept"] = accept
    req = urllib.request.Request(url, headers=headers)
    with urllib.request.urlopen(req, timeout=TIMEOUT) as resp:
        return resp.read().decode("utf-8", "replace")


def run(cmd):
    return subprocess.run(cmd, capture_output=True, text=True).stdout


def load_allowlist():
    """Lines of 'pkgname version'. Only that exact version is allowed."""
    allowed = set()
    try:
        with open(ALLOWLIST) as f:
            for line in f:
                parts = line.split("#", 1)[0].split()
                if len(parts) == 2:
                    allowed.add((parts[0], parts[1]))
    except FileNotFoundError:
        pass
    return allowed


LOG = []


def say(text=""):
    """Print a report line and keep a plain-text copy for the block report."""
    print(text)
    LOG.append(re.sub(r"\033\[[0-9;]*m", "", text))


def real_user():
    """The human behind this run. The pacman hook runs as root via sudo."""
    for var in ("SUDO_UID", "PKEXEC_UID"):
        if os.environ.get(var, "").isdigit():
            try:
                return pwd.getpwuid(int(os.environ[var]))
            except KeyError:
                pass
    return pwd.getpwuid(os.getuid())


def blocked(context):
    """Save everything reported so far to ~/aur-audit-blocked-<time>.txt, return 1."""
    user = real_user()
    path = os.path.join(user.pw_dir, time.strftime("aur-audit-blocked-%Y-%m-%d_%H-%M-%S.txt"))
    header = [f"aur-audit blocked an AUR package on {time.strftime('%Y-%m-%d %H:%M:%S %Z')}",
              f"Stage: {context}", "",
              "BLOCK = reason it was stopped, WARN = worth knowing, INFO = background facts.",
              f"To allow a package you have reviewed, add its 'name version' line to {ALLOWLIST}.",
              ""]
    try:
        with open(path, "w") as f:
            f.write("\n".join(header + LOG) + "\n")
        os.chown(path, user.pw_uid, user.pw_gid)
        print(f"==> aur-audit: full report saved to {path}")
    except OSError as e:
        print(f"==> aur-audit: could not save report to {path}: {e}")
    return 1


class Report:
    def __init__(self, name):
        self.name = name
        self.location = name
        self.version = None
        self.findings = []

    def add(self, level, msg):
        self.findings.append((level, msg))

    def blocked(self):
        return any(level == BLOCK for level, _ in self.findings)


# ---------------------------------------------------------------- AUR reputation

SUSPICIOUS_SUFFIXES = ("fix", "fixed", "patch", "patched", "update", "updated",
                       "official", "secure", "new", "latest", "stable")


def check_aur_info(rep, info, repo_names):
    now = time.time()
    age_days = (now - info["FirstSubmitted"]) / DAY
    votes = info["NumVotes"]
    pop = info["Popularity"]

    rep.add(INFO, f"AUR: maintainer={info['Maintainer'] or 'none'}, votes={votes}, "
                  f"popularity={pop:.3f}, first submitted {age_days:.0f} days ago")

    if age_days < 14 and votes < 10:
        rep.add(BLOCK, f"brand new AUR package ({age_days:.0f} days old, {votes} votes); "
                       "most AUR malware has looked exactly like this")
    elif age_days < 90 and votes < 5:
        rep.add(WARN, f"young package with little community vetting "
                      f"({age_days:.0f} days, {votes} votes)")

    if info["Maintainer"] is None:
        rep.add(WARN, "package is orphaned (no maintainer); anyone can adopt it and push changes")
    if votes < 3 and pop < 0.01:
        rep.add(WARN, "almost nobody uses this package")
    if info["OutOfDate"]:
        rep.add(INFO, "flagged out-of-date on the AUR")

    check_impersonation(rep, info["Name"], votes, age_days, info.get("URL"), repo_names)
    check_mass_upload(rep, info["Maintainer"])

    # Typosquatting: e.g. "firefox-patch-bin" posing as a fix for the real "firefox".
    stem = re.sub(r"-(bin|git)$", "", info["Name"])
    for suf in SUSPICIOUS_SUFFIXES:
        if stem.endswith("-" + suf) and stem[: -len(suf) - 1] in repo_names:
            rep.add(WARN if votes >= 10 else BLOCK,
                    f"name looks like a variant of official package "
                    f"'{stem[: -len(suf) - 1]}' (classic AUR malware naming)")
            break


LOOKALIKES = {"l": ["1", "i"], "1": ["l", "i"], "i": ["l", "1"], "o": ["0"], "0": ["o"],
              "rn": ["m"], "m": ["rn"], "vv": ["w"], "w": ["vv"]}
NAME_SUFFIX = re.compile(r"-(bin|git|appimage|beta|nightly)$")
KEYBOARD = ["1234567890", "qwertyuiop", "asdfghjkl", "zxcvbnm"]
NEIGHBOURS = {}
for _r, _row in enumerate(KEYBOARD):
    for _c, _ch in enumerate(_row):
        NEIGHBOURS[_ch] = {KEYBOARD[r][c] for r in (_r - 1, _r, _r + 1) if 0 <= r < len(KEYBOARD)
                           for c in (_c - 1, _c, _c + 1) if 0 <= c < len(KEYBOARD[r])} - {_ch}


def typo_variants(name):
    """Names this one could be a typo of: doubled letters (yyay), an extra letter
    in the middle (payru), swapped letters (yya), and look-alike characters."""
    out = set()
    for i in range(len(name) - 1):
        if name[i] == name[i + 1] or 0 < i:
            out.add(name[:i] + name[i + 1:])               # remove one character
        out.add(name[:i] + name[i + 1] + name[i] + name[i + 2:])  # swap neighbours
    for i, ch in enumerate(name):                          # neighbouring key hit
        for n in NEIGHBOURS.get(ch, ()):
            out.add(name[:i] + n + name[i + 1:])
    for bad, goods in LOOKALIKES.items():
        for i in range(len(name)):
            if name.startswith(bad, i):
                for good in goods:
                    out.add(name[:i] + good + name[i + len(bad):])
    out.discard(name)
    return {v for v in out if len(v) >= 3 and not v.startswith("-") and not v.endswith("-")}


def check_impersonation(rep, name, votes, age_days, url, repo_names):
    """Flag names one typo away from a much more popular package (e.g. yyay -> yay)."""
    if votes >= 50:
        return  # an established package isn't an impersonator, even with a similar name
    m = NAME_SUFFIX.search(name)
    suffix = m.group(0) if m else ""
    stem = name[: len(name) - len(suffix)]
    candidates = set()
    # A typo in the ending itself, e.g. "visual-studio-code-bim" for "...-bin".
    if not suffix and "-" in name:
        head, last = name.rsplit("-", 1)
        for real in ("bin", "git"):
            if last in typo_variants(real) | {real + real[-1]}:
                candidates.add(f"{head}-{real}")
    for v in typo_variants(stem):
        candidates.update({v, v + suffix, v + "-bin", v + "-git"})
    candidates -= {name, stem}
    if not candidates:
        return
    try:
        names = sorted(candidates)
        infos = {}
        for i in range(0, min(len(names), 400), 100):
            infos.update(aur_info(names[i:i + 100]))
    except OSError:
        infos = {}
    for c in sorted(candidates):
        if c in repo_names:
            popular, where, other_url = True, "repo package", None
        elif c in infos:
            other = infos[c]
            popular = other["NumVotes"] >= 50 and other["NumVotes"] >= 10 * max(votes, 1)
            where, other_url = f"popular AUR package ({other['NumVotes']} votes)", other.get("URL")
        else:
            continue
        if not popular:
            continue
        same = " and points to the same upstream project" if url and url == other_url else ""
        serious = votes < 10 and age_days < 90
        rep.add(BLOCK if serious else WARN,
                f"name is one typo away from {where} '{c}'{same}; impersonating popular "
                "packages is how the Oct 2026 fake-yay malware spread"
                + ("" if serious else " (may be a coincidence for an established package)"))
        return


def check_mass_upload(rep, maintainer):
    """Malware accounts often upload many packages at once."""
    if not maintainer:
        return
    try:
        data = json.loads(http_get(f"{AUR}/rpc/v5/search/{urllib.parse.quote(maintainer)}"
                                   "?by=maintainer"))
    except (OSError, ValueError):
        return
    recent = [r for r in data.get("results", [])
              if time.time() - r["FirstSubmitted"] < 7 * DAY]
    if len(recent) >= 5:
        rep.add(WARN, f"maintainer '{maintainer}' uploaded {len(recent)} new packages in the "
                      "last 7 days (mass uploads are a common malware pattern)")



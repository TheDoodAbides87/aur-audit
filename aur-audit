]


def pkginfo_field(text, key):
    m = re.search(rf"^{key} = (.+)$", text, re.MULTILINE)
    return m.group(1) if m else None


def audit_package_file(rep, path):
    pkginfo = run(["bsdtar", "-xOf", path, ".PKGINFO"])
    rep.version = rep.version or pkginfo_field(pkginfo, "pkgver")

    install = run(["bsdtar", "-xOf", path, ".INSTALL"])
    if install.strip():
        scan_script(rep, ".INSTALL (runs as root):", install, INSTALL_RULES)

    for line in run(["bsdtar", "-tvf", path]).splitlines():
        fields = line.split(None, 8)
        if len(fields) < 9:
            continue
        mode, fname = fields[0], fields[8].split(" -> ")[0]
        if fname.startswith("."):
            continue
        for level, pattern, desc in PATH_RULES:
            if re.search(pattern, fname):
                rep.add(level, f"package {desc}: /{fname}")
        if mode[0] == "-" and (mode[3] in "sS" or mode[6] in "sS"):
            rep.add(WARN, f"setuid/setgid file (runs with elevated privileges): /{fname}")


# ---------------------------------------------------------------- orchestration

def repo_package_names():
    return set(run(["pacman", "-Slq"]).split())


def aur_info(names):
    if not names:
        return {}
    query = "&".join("arg[]=" + urllib.parse.quote(n) for n in names)
    data = json.loads(http_get(f"{AUR}/rpc/v5/info?{query}"))
    return {r["Name"]: r for r in data.get("results", [])}


def audit(name, pkgfile, info, repo_names):
    rep = Report(name)
    if pkgfile:
        rep.location = os.path.dirname(os.path.abspath(pkgfile))
        rep.version = pkginfo_field(run(["bsdtar", "-xOf", pkgfile, ".PKGINFO"]), "pkgver")

    if info is None:
        rep.add(WARN, "not found on the AUR (local/custom package, or deleted from the AUR, "
                      "which often happens when a package is removed for being malicious)")
    else:
        check_aur_info(rep, info, repo_names)
        base = urllib.parse.quote(info["PackageBase"])
        try:
            srcinfo = http_get(f"{AUR}/cgit/aur.git/plain/.SRCINFO?h={base}")
            check_sources(rep, *parse_srcinfo(srcinfo))
            pkgbuild = http_get(f"{AUR}/cgit/aur.git/plain/PKGBUILD?h={base}")
            scan_script(rep, "PKGBUILD", pkgbuild, PKGBUILD_RULES)
        except OSError as e:
            rep.add(BLOCK, f"could not download PKGBUILD/.SRCINFO to audit it: {e}")
        if rep.version and rep.version != info["Version"]:
            rep.add(WARN, f"built version {rep.version} differs from current AUR version "
                          f"{info['Version']}")

    if pkgfile:
        audit_package_file(rep, pkgfile)
    return rep


def srcinfo_fields(text, key):
    return [m.group(1).strip() for m in re.finditer(rf"^\s*{key}\s*=\s*(.+)$", text, re.MULTILINE)]


def audit_build_dir(path):
    """Audit the files yay is about to build, before makepkg sources the PKGBUILD."""
    read = lambda name: open(os.path.join(path, name), errors="replace").read()
    try:
        srcinfo, pkgbuild = read(".SRCINFO"), read("PKGBUILD")
    except OSError as e:
        say(f"==> aur-audit: cannot read PKGBUILD/.SRCINFO in {path} ({e}); refusing to build.")
        return blocked("before build (yay, via aur-audit-makepkg) in " + os.path.abspath(path))

    installs = {}
    for name in srcinfo_fields(srcinfo, "install"):
        try:
            installs[name] = read(name)
        except OSError:
            pass

    # yay calls makepkg several times per package, and keeps going after a failed call.
    # Remember results so each version of the files is only audited (and reported) once.
    # The allowlist is part of the fingerprint, so allowlisting a package re-audits it.
    try:
        allowlist_text = open(ALLOWLIST).read()
    except OSError:
        allowlist_text = ""
    digest = hashlib.sha256((srcinfo + pkgbuild + "".join(installs.values())
                             + allowlist_text).encode()).hexdigest()
    marker = os.path.join(path, ".aur-audit-passed")
    block_marker = os.path.join(path, ".aur-audit-blocked")
    try:
        if open(marker).read().strip() == digest:
            return 0
    except OSError:
        pass
    try:
        # A block is only remembered for 10 minutes: votes and age change over time.
        if (open(block_marker).read().strip() == digest
                and time.time() - os.path.getmtime(block_marker) < 600):
            print("==> aur-audit: still blocked (see the aur-audit-blocked report in your "
                  "home folder)")
            return 1
    except OSError:
        pass

    base = (srcinfo_fields(srcinfo, "pkgbase") or ["?"])[0]
    names = srcinfo_fields(srcinfo, "pkgname")
    epoch = (srcinfo_fields(srcinfo, "epoch") or [None])[0]
    version = (srcinfo_fields(srcinfo, "pkgver") or ["?"])[0] + "-" + \
              (srcinfo_fields(srcinfo, "pkgrel") or ["?"])[0]
    if epoch:
        version = f"{epoch}:{version}"

    rep = Report(base)
    rep.location = os.path.abspath(path)
    rep.version = version
    try:
        infos = aur_info(names)
    except OSError as e:
        say(f"==> aur-audit: cannot reach the AUR ({e}); refusing to build unverified "
              "AUR packages.")
        return blocked("before build (yay, via aur-audit-makepkg) in " + os.path.abspath(path))

    info = next((infos[n] for n in names if n in infos), None)
    if info is None:
        rep.add(WARN, "not found on the AUR (local/custom package, or deleted from the AUR, "
                      "which often happens when a package is removed for being malicious)")
        check_impersonation(rep, base, 0, 0, (srcinfo_fields(srcinfo, "url") or [None])[0],
                            repo_package_names())
    else:
        check_aur_info(rep, info, repo_package_names())
        if version != info["Version"] and not base.endswith(VCS_SUFFIXES):
            rep.add(WARN, f"local version {version} differs from current AUR version "
                          f"{info['Version']}")

    check_sources(rep, *parse_srcinfo(srcinfo))
    scan_script(rep, "PKGBUILD", pkgbuild, PKGBUILD_RULES)
    for name, text in installs.items():
        scan_script(rep, f"{name} (runs as root at install):", text, INSTALL_RULES)
    check_update_diff(rep, path, names)

    if print_report(rep, load_allowlist()):
        say("\n==> aur-audit: hazardous AUR package found. Build cancelled before any "
              "of its code ran.")
        with open(block_marker, "w") as f:
            f.write(digest + "\n")
        return blocked("before build (yay, via aur-audit-makepkg) in " + os.path.abspath(path))
    with open(marker, "w") as f:
        f.write(digest + "\n")
    return 0


def git(path, *args):
    """Read-only git in a yay build folder. External diff/textconv helpers are
    disabled so a malicious repo can't make git run anything."""
    return run(["git", "-C", path, "-c", "core.pager=cat", "--no-pager", *args])


def srcinfo_version(text):
    f = lambda k: (srcinfo_fields(text, k) or [""])[0]
    v = f"{f('pkgver')}-{f('pkgrel')}"
    return f"{f('epoch')}:{v}" if f("epoch") else v


def check_update_diff(rep, path, names):
    """For updates: what changed since the version you have installed? A new
    committer adding downloads or package installs is the June 2026 takeover pattern."""
    if not os.path.isdir(os.path.join(path, ".git")):
        return
    installed = next((v for v in (local_db_entry(n)[0] for n in names) if v), None)
    if not installed:
        return

    history = git(path, "log", "--format=%H", "-n", "300", "--", ".SRCINFO").split()
    baseline = next((h for h in history
                     if srcinfo_version(git(path, "show", f"{h}:.SRCINFO")) == installed), None)
    label = f"your installed version {installed}"
    if baseline is None:
        if len(history) < 2:
            return
        baseline, label = history[1], "the previous AUR version"
    if git(path, "rev-parse", "HEAD").strip() == baseline:
        return

    diff = git(path, "diff", "--no-ext-diff", "--no-textconv", baseline, "HEAD", "--",
               ".", ":(exclude).SRCINFO")
    added = "\n".join(l[1:] for l in diff.splitlines()
                      if l.startswith("+") and not l.startswith("+++"))
    risky = []
    probe = Report("diff")
    scan_script(probe, "", added, DIFF_RULES)
    for level, msg in probe.findings:
        risky.append(msg.strip())

    old_src = git(path, "show", f"{baseline}:.SRCINFO")
    new_src = git(path, "show", "HEAD:.SRCINFO")
    host = lambda u: (urllib.parse.urlparse(re.sub(r"^\w+\+", "", u.split("::", 1)[-1]))
                      .hostname or "")
    old_hosts = {host(u) for u in parse_srcinfo(old_src)[0]}
    new_hosts = {host(u) for u in parse_srcinfo(new_src)[0]} - old_hosts - {""}
    if new_hosts:
        risky.append("downloads from new website(s): " + ", ".join(sorted(new_hosts)))
    if set(srcinfo_fields(new_src, "install")) - set(srcinfo_fields(old_src, "install")):
        risky.append("adds an install script (runs as root)")

    authors = lambda rng: {a for a in git(path, "log", "--format=%an <%ae>", rng).splitlines() if a}
    new_authors = authors(f"{baseline}..HEAD") - authors(baseline)

    if new_authors:
        rep.add(WARN if not risky else BLOCK,
                f"changed hands since {label}: new committer(s) "
                + ", ".join(sorted(new_authors))
                + ("" if not risky else
                   ". They added: " + "; ".join(risky[:4])
                   + ". A new maintainer adding code like this is how the June 2026 "
                     "AUR takeover attack worked"))
    elif risky:
        rep.add(WARN, f"since {label}, this update added: " + "; ".join(risky[:4]))


def pacman_package_files():
    """pacman -U is given package file paths; read them from our parent's cmdline."""
    files = {}
    try:
        with open(f"/proc/{os.getppid()}/cmdline", "rb") as f:
            args = f.read().decode("utf-8", "replace").split("\0")
    except OSError:
        return files
    for arg in args:
        if re.search(r"\.pkg\.tar(\.\w+)?$", arg) and not arg.startswith("/"):
            arg = os.path.join(f"/proc/{os.getppid()}/cwd", arg)
        if re.search(r"\.pkg\.tar(\.\w+)?$", arg) and os.path.isfile(arg):
            name = pkginfo_field(run(["bsdtar", "-xOf", arg, ".PKGINFO"]), "pkgname")
            if name:
                files[name] = arg
    return files


def lookup_name(name, infos):
    """Split debug packages (foo-debug) are audited as their parent."""
    if name in infos:
        return infos[name]
    if name.endswith("-debug"):
        return infos.get(name[: -len("-debug")])
    return None


def print_report(rep, allowed):
    color = sys.stdout.isatty() and "NO_COLOR" not in os.environ
    paint = {BLOCK: "\033[1;31m", WARN: "\033[1;33m", INFO: "\033[2m"} if color else {}
    reset = "\033[0m" if color else ""

    say(f"\n==> aur-audit: {rep.name} {rep.version or ''}")
    order = {BLOCK: 0, WARN: 1, INFO: 2}
    for level, msg in sorted(rep.findings, key=lambda f: order[f[0]]):
        say(f"  {paint.get(level, '')}[{level}]{reset} {msg}")

    if not rep.blocked():
        say("  -> passed")
        return False
    if (rep.name, rep.version) in allowed:
        say(f"  -> BLOCK findings overridden by {ALLOWLIST}")
        return False
    say(f"  {paint.get(BLOCK, '')}-> HAZARDOUS: refusing to install.{reset}")
    say(f"     If you have reviewed it and trust it, add this line to {ALLOWLIST}:")
    say(f"       {rep.name} {rep.version or '<version>'}")
    say("     Not sure? Have your AI assistant check whether it is actually malicious:")
    say(f"       aur-audit ai {rep.location}")
    return True



#!/usr/bin/python3 -I
"""
aur-audit: security audit for AUR packages, run as a pacman PreTransaction hook.

Modes:
  aur-audit --hook             Called by pacman. Reads target names on stdin.
  aur-audit dir BUILDDIR       Audit a PKGBUILD directory before makepkg touches it
                               (used by the aur-audit-makepkg wrapper for yay).
  aur-audit check PKG...       Audit AUR packages by name BEFORE building them.
  aur-audit file PKGFILE...    Audit already-built package files.
  aur-audit ai PKG|DIR         Ask your AI assistant whether a blocked package is
                               actually malicious (optional; never unblocks anything).
  aur-audit ai --installed PKG Ask your AI assistant to review a package you
                               already have installed (AUR or official repos).

Exit status 1 means at least one BLOCK finding was not allowlisted. In hook
mode, pacman's AbortOnFail turns that into a cancelled transaction.
"""

import hashlib
import ipaddress
import json
import os
import pwd
import shutil
import stat
import re
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.parse
import urllib.request

AUR = "https://aur.archlinux.org"
ALLOWLIST = "/etc/aur-audit/allowlist"
TIMEOUT = 15
DAY = 86400

BLOCK, WARN, INFO = "BLOCK", "WARN", "INFO"


# ---------------------------------------------------------------- helpers

def http_get(url, accept=None):
    headers = {"User-Agent": "aur-audit/1.0"}
    if accept:
        headers["Accept"] = accept
    req = urllib.request.Request(url, headers=headers)
    with urllib.request.urlopen(req, timeout=TIMEOUT) as resp:
        return resp.read().decode("utf-8", "replace")


def run(cmd):
    return subprocess.run(cmd, capture_output=True, text=True).stdout


def load_allowlist():
    """Lines of 'pkgname version'. Only that exact version is allowed."""
    allowed = set()
    try:
        with open(ALLOWLIST) as f:
            for line in f:
                parts = line.split("#", 1)[0].split()
                if len(parts) == 2:
                    allowed.add((parts[0], parts[1]))
    except FileNotFoundError:
        pass
    return allowed


LOG = []


def say(text=""):
    """Print a report line and keep a plain-text copy for the block report."""
    print(text)
    LOG.append(re.sub(r"\033\[[0-9;]*m", "", text))


def real_user():
    """The human behind this run. The pacman hook runs as root via sudo."""
    for var in ("SUDO_UID", "PKEXEC_UID"):
        if os.environ.get(var, "").isdigit():
            try:
                return pwd.getpwuid(int(os.environ[var]))
            except KeyError:
                pass
    return pwd.getpwuid(os.getuid())


def blocked(context):
    """Save everything reported so far to ~/aur-audit-blocked-<time>.txt, return 1."""
    user = real_user()
    path = os.path.join(user.pw_dir, time.strftime("aur-audit-blocked-%Y-%m-%d_%H-%M-%S.txt"))
    header = [f"aur-audit blocked an AUR package on {time.strftime('%Y-%m-%d %H:%M:%S %Z')}",
              f"Stage: {context}", "",
              "BLOCK = reason it was stopped, WARN = worth knowing, INFO = background facts.",
              f"To allow a package you have reviewed, add its 'name version' line to {ALLOWLIST}.",
              ""]
    try:
        with open(path, "w") as f:
            f.write("\n".join(header + LOG) + "\n")
        os.chown(path, user.pw_uid, user.pw_gid)
        print(f"==> aur-audit: full report saved to {path}")
    except OSError as e:
        print(f"==> aur-audit: could not save report to {path}: {e}")
    return 1


class Report:
    def __init__(self, name):
        self.name = name
        self.location = name
        self.version = None
        self.findings = []

    def add(self, level, msg):
        self.findings.append((level, msg))

    def blocked(self):
        return any(level == BLOCK for level, _ in self.findings)


# ---------------------------------------------------------------- AUR reputation

SUSPICIOUS_SUFFIXES = ("fix", "fixed", "patch", "patched", "update", "updated",
                       "official", "secure", "new", "latest", "stable")


def check_aur_info(rep, info, repo_names):
    now = time.time()
    age_days = (now - info["FirstSubmitted"]) / DAY
    votes = info["NumVotes"]
    pop = info["Popularity"]

    rep.add(INFO, f"AUR: maintainer={info['Maintainer'] or 'none'}, votes={votes}, "
                  f"popularity={pop:.3f}, first submitted {age_days:.0f} days ago")

    if age_days < 14 and votes < 10:
        rep.add(BLOCK, f"brand new AUR package ({age_days:.0f} days old, {votes} votes); "
                       "most AUR malware has looked exactly like this")
    elif age_days < 90 and votes < 5:
        rep.add(WARN, f"young package with little community vetting "
                      f"({age_days:.0f} days, {votes} votes)")

    if info["Maintainer"] is None:
        rep.add(WARN, "package is orphaned (no maintainer); anyone can adopt it and push changes")
    if votes < 3 and pop < 0.01:
        rep.add(WARN, "almost nobody uses this package")
    if info["OutOfDate"]:
        rep.add(INFO, "flagged out-of-date on the AUR")

    # Typosquatting: e.g. "firefox-patch-bin" posing as a fix for the real "firefox".
    stem = re.sub(r"-(bin|git)$", "", info["Name"])
    for suf in SUSPICIOUS_SUFFIXES:
        if stem.endswith("-" + suf) and stem[: -len(suf) - 1] in repo_names:
            rep.add(WARN if votes >= 10 else BLOCK,
                    f"name looks like a variant of official package "
                    f"'{stem[: -len(suf) - 1]}' (classic AUR malware naming)")
            break


# ---------------------------------------------------------------- sources

BAD_HOSTS = {
    "pastebin.com", "paste.ee", "hastebin.com", "ghostbin.com", "transfer.sh",
    "bit.ly", "tinyurl.com", "is.gd", "t.co", "goo.gl", "rb.gy", "cutt.ly",
    "cdn.discordapp.com", "media.discordapp.net", "discord.com",
    "anonfiles.com", "file.io", "mega.nz", "mediafire.com", "gofile.io",
    "temp.sh", "0x0.st", "catbox.moe", "files.catbox.moe", "termbin.com",
}
BAD_HOST_SUFFIXES = (".ngrok.io", ".ngrok-free.app", ".trycloudflare.com", ".duckdns.org")
VCS_PREFIXES = ("git+", "git://", "svn+", "hg+", "bzr+", "fossil+")
VCS_SUFFIXES = ("-git", "-svn", "-hg", "-bzr", "-fossil")


def parse_srcinfo(text):
    sources, sums = [], []
    for line in text.splitlines():
        line = line.strip()
        m = re.match(r"(source(?:_\w+)?)\s*=\s*(.+)", line)
        if m:
            sources.append(m.group(2))
        m = re.match(r"(?:sha\d+|b2|md5|ck)sums(?:_\w+)?\s*=\s*(.+)", line)
        if m:
            sums.append(m.group(1))
    return sources, sums


def check_sources(rep, sources, sums):
    github_repos = set()
    for i, src in enumerate(sources):
        url = src.split("::", 1)[-1]
        if "://" not in url:
            continue  # local file shipped with the PKGBUILD
        is_vcs = url.startswith(VCS_PREFIXES)
        bare = re.sub(r"^\w+\+", "", url)
        parsed = urllib.parse.urlparse(bare)
        host = (parsed.hostname or "").lower()

        try:
            ipaddress.ip_address(host)
            rep.add(BLOCK, f"source downloads from a raw IP address: {url}")
            continue
        except ValueError:
            pass

        if host in BAD_HOSTS or host.endswith(BAD_HOST_SUFFIXES):
            rep.add(BLOCK, f"source uses a paste/file-sharing/shortener host: {url}")
        elif host == "gist.githubusercontent.com" or host == "gist.github.com":
            rep.add(WARN, f"source comes from a GitHub gist: {url}")

        if parsed.scheme in ("http", "ftp") and not is_vcs:
            rep.add(WARN, f"source fetched over unencrypted {parsed.scheme}: {url}")

        is_signature = parsed.path.endswith((".asc", ".sig", ".sign"))
        if not is_vcs and not is_signature and i < len(sums) and sums[i] == "SKIP":
            rep.add(WARN, f"checksum is SKIP for a non-VCS download: {url}")

        if host in ("github.com", "raw.githubusercontent.com", "objects.githubusercontent.com"):
            parts = [p for p in parsed.path.split("/") if p]
            if len(parts) >= 2:
                github_repos.add((parts[0], parts[1].removesuffix(".git")))

    for owner, repo in sorted(github_repos):
        check_github_repo(rep, owner, repo)


def check_github_repo(rep, owner, repo):
    try:
        data = json.loads(http_get(f"https://api.github.com/repos/{owner}/{repo}",
                                   accept="application/vnd.github+json"))
    except urllib.error.HTTPError as e:
        if e.code == 404:
            rep.add(WARN, f"GitHub repo {owner}/{repo} does not exist or is private")
        else:
            rep.add(INFO, f"could not check GitHub repo {owner}/{repo} (HTTP {e.code}, "
                          "probably API rate limit)")
        return
    except OSError as e:
        rep.add(INFO, f"could not check GitHub repo {owner}/{repo}: {e}")
        return

    created = time.mktime(time.strptime(data["created_at"], "%Y-%m-%dT%H:%M:%SZ"))
    age_days = (time.time() - created) / DAY
    stars = data["stargazers_count"]
    rep.add(INFO, f"GitHub {owner}/{repo}: {stars} stars, created {age_days:.0f} days ago")
    if age_days < 30 and stars < 10:
        rep.add(BLOCK, f"upstream GitHub repo {owner}/{repo} is brand new with almost no "
                       f"stars ({age_days:.0f} days, {stars} stars)")
    elif stars < 5:
        rep.add(WARN, f"upstream GitHub repo {owner}/{repo} has very few stars ({stars})")
    if data.get("archived"):
        rep.add(INFO, f"upstream GitHub repo {owner}/{repo} is archived")



def gather_for_ai(target):
    """Collect the blocked package's files and latest block report as one text."""
    path = target if os.path.isdir(target) else os.path.expanduser(f"~/.cache/yay/{target}")
    if not os.path.isdir(path):
        return None, None, False

    name = os.path.basename(os.path.normpath(path))
    found_report = False
    parts = []
    reports = sorted((f for f in os.listdir(os.path.expanduser("~"))
                      if f.startswith("aur-audit-blocked-")), reverse=True)
    for r in reports:
        text = open(os.path.expanduser(f"~/{r}"), errors="replace").read()
        if f"aur-audit: {name} " in text:
            parts.append(f"===== aur-audit block report ({r}) =====\n{text}")
            found_report = True
            break

    for f in sorted(os.listdir(path)):
        full = os.path.join(path, f)
        if not os.path.isfile(full) or f.startswith(".aur-audit"):
            continue
        if re.search(r"\.pkg\.tar(\.\w+)?$", f):
            install = run(["bsdtar", "-xOf", full, ".INSTALL"])
            listing = run(["bsdtar", "-tvf", full]).splitlines()
            parts.append(f"===== built package {f}: .INSTALL =====\n{install or '(none)'}")
            parts.append(f"===== built package {f}: file list (first 300) =====\n"
                         + "\n".join(listing[:300]))
        elif os.path.getsize(full) <= 64 * 1024:
            try:
                parts.append(f"===== {f} =====\n" + open(full, encoding="utf-8").read())
            except (UnicodeDecodeError, OSError):
                pass  # binary or source archive
    return name, "\n\n".join(parts), found_report


OFFICIAL_REPOS = ("core", "extra", "multilib", "core-testing", "extra-testing",
                  "multilib-testing")


def local_db_entry(name):
    """pacman's record of an installed package: (version, folder) or (None, None)."""
    out = run(["pacman", "-Q", name]).split()
    if len(out) != 2:
        return None, None
    return out[1], f"/var/lib/pacman/local/{out[0]}-{out[1]}"


def format_findings(rep):
    order = {BLOCK: 0, WARN: 1, INFO: 2}
    lines = [f"  [{lvl}] {msg}" for lvl, msg in sorted(rep.findings, key=lambda f: order[f[0]])]
    return "\n".join(lines) or "  (no findings)"


def gather_installed(name):
    """Collect everything known about an installed package for the AI."""
    version, dbdir = local_db_entry(name)
    if not version:
        return None
    desc = open(os.path.join(dbdir, "desc"), errors="replace").read()
    base = re.search(r"%BASE%\n(.+)", desc)
    base = base.group(1) if base else name

    rep = Report(name)
    rep.version = version
    parts = [f"===== pacman -Qi {name} =====\n" + run(["pacman", "-Qi", name])]

    repo = re.search(r"^Repository\s*:\s*(\S+)", run(["pacman", "-Si", name]), re.MULTILINE)
    repo = repo.group(1) if repo else None

    # The build recipe, preferring the exact installed version.
    pkgbuild = srcinfo = None
    if repo in OFFICIAL_REPOS:
        rep.add(INFO, f"official Arch package from [{repo}]")
        url = f"https://gitlab.archlinux.org/archlinux/packaging/packages/{base}/-/raw"
        for ref, label in ((version.replace(":", "-"), f"for installed version {version}"),
                           ("main", "CURRENT version in Arch's packaging repo")):
            try:
                pkgbuild = http_get(f"{url}/{ref}/PKGBUILD")
                srcinfo = http_get(f"{url}/{ref}/.SRCINFO")
                parts.append(f"===== PKGBUILD ({label}) =====\n{pkgbuild}")
                break
            except OSError:
                continue
    elif repo:
        rep.add(INFO, f"from the third-party repo [{repo}]; its PKGBUILD isn't available here")
    else:
        try:
            info = aur_info([name]).get(name)
        except OSError:
            info = None
        if info:
            check_aur_info(rep, info, repo_package_names())
        else:
            rep.add(WARN, "installed from outside any repo and not on the AUR (custom package, "
                          "or deleted from the AUR)")
        cache = os.path.expanduser(f"~/.cache/yay/{base}")
        try:
            local_src = open(os.path.join(cache, ".SRCINFO"), errors="replace").read()
            fields = lambda k: srcinfo_fields(local_src, k)
            cached = f"{fields('pkgver')[0]}-{fields('pkgrel')[0]}"
            if fields("epoch"):
                cached = f"{fields('epoch')[0]}:{cached}"
            if cached == version:
                srcinfo = local_src
                pkgbuild = open(os.path.join(cache, "PKGBUILD"), errors="replace").read()
                parts.append(f"===== PKGBUILD (the build files yay used for {version}) =====\n"
                             + pkgbuild)
        except (OSError, IndexError):
            pass
        if pkgbuild is None and info:
            try:
                q = urllib.parse.quote(info["PackageBase"])
                pkgbuild = http_get(f"{AUR}/cgit/aur.git/plain/PKGBUILD?h={q}")
                srcinfo = http_get(f"{AUR}/cgit/aur.git/plain/.SRCINFO?h={q}")
                parts.append(f"===== PKGBUILD (CURRENT AUR version {info['Version']}; "
                             f"installed is {version}, so it may differ) =====\n{pkgbuild}")
            except OSError:
                pass
    if pkgbuild is None:
        parts.append("===== PKGBUILD =====\n(not available)")
    else:
        parts.append(f"===== .SRCINFO =====\n{srcinfo}")
        check_sources(rep, *parse_srcinfo(srcinfo))
        scan_script(rep, "PKGBUILD", pkgbuild, PKGBUILD_RULES)

    try:
        install = open(os.path.join(dbdir, "install"), errors="replace").read()
        scan_script(rep, "install script (ran as root):", install, INSTALL_RULES)
        parts.append(f"===== install script (as installed; ran as root) =====\n{install}")
    except OSError:
        parts.append("===== install script =====\n(none)")

    # Installed files, flagging setuid/setgid ones and risky locations.
    files = run(["pacman", "-Qlq", name]).splitlines()
    listing = []
    for path in files:
        for level, pattern, d in PATH_RULES:
            if re.search(pattern, path.lstrip("/")):
                rep.add(level, f"package {d}: {path}")
        try:
            st = os.lstat(path)
            special = stat.S_ISREG(st.st_mode) and st.st_mode & (stat.S_ISUID | stat.S_ISGID)
        except OSError:
            special = False
        if special:
            rep.add(WARN, f"setuid/setgid file (runs with elevated privileges): {path}")
        listing.append(path + ("    <-- SETUID/SETGID" if special else ""))
    parts.append(f"===== installed files ({len(files)}, first 400) =====\n"
                 + "\n".join(listing[:400]))

    # Compare installed files with the checksums recorded at install time.
    check = subprocess.run(["pacman", "-Qkk", name], capture_output=True, text=True)
    out = (check.stdout + check.stderr).splitlines()
    unreadable = lambda l: "Permission denied" in l or "failed to calculate" in l
    denied = [l for l in out if unreadable(l)]
    changed = [l for l in out if not unreadable(l) and "warning" in l.lower()]
    if any(not re.search(r"\(backup file\)|Modification time mismatch", l) for l in changed):
        rep.add(WARN, "some installed files differ from what the package installed "
                      "(see integrity check)")
    summary = [l for l in out if "total files" in l]
    parts.append("===== integrity check (pacman -Qkk) =====\n"
                 + "\n".join(summary + changed[:100])
                 + (f"\n({len(denied)} files could not be read without root and were skipped; "
                    "pacman counts these as 'altered', but that does not mean they changed)"
                    if denied else ""))

    parts.insert(0, f"===== aur-audit rule-based findings =====\n{format_findings(rep)}")
    return rep, "\n\n".join(parts)


def ai_review(target, installed=False):
    if os.geteuid() == 0:
        print("aur-audit ai: run this as yourself, not with sudo.")
        return 2

    content = None
    if not installed:
        name, content, was_blocked = gather_for_ai(target)
        if not was_blocked and local_db_entry(target)[0]:
            print(f"==> No block report for '{target}'; reviewing the installed package.")
            installed = True
    if installed:
        if not local_db_entry(target)[0]:
            print(f"aur-audit ai: '{target}' is not installed (check the name with pacman -Qs).")
            return 2
        print(f"==> Gathering information about installed package {target}...")
        rep, content = gather_installed(target)
        name = target
        print(f"\n==> aur-audit rule-based findings for {name} {rep.version}:")
        print(format_findings(rep) + "\n")
    if not content:
        print(f"aur-audit ai: no build files found for '{target}'. Pass the folder shown "
              "in the block message.")
        return 2
    instructions = (AI_INTRO_INSTALLED if installed else AI_INTRO_BLOCKED) + "\n" + AI_INSTRUCTIONS
    tool, model = choose_ai()
    if not tool:
        return 2

    print(f"==> Asking {tool}{' (' + model + ')' if model else ''} to review {name}. "
          "This uses your AI assistant's normal usage/credits.\n")
    out = os.path.expanduser(time.strftime(f"~/aur-audit-ai-review-{name}-%Y-%m-%d_%H-%M-%S.txt"))
    if installed:
        closing = ("The AI can be wrong. If it flags something, look into it before acting. "
                   f"To remove the package: sudo pacman -Rns {name}")
    else:
        closing = f"The AI can be wrong. The package stays blocked unless YOU add it to {ALLOWLIST}."
    return run_ai(tool, model, instructions, content, name, out, closing)


AI_STALL = 120         # seconds without any data from claude: the answer stalled
AI_MAX_ANSWER = 60000  # characters; real answers are 3,000-10,000


def run_claude_watched(cmd, stdin, cwd, env, attempts=2):
    """Run claude -p with streaming output, stopping answers that go wrong.

    With its tools disabled, claude sometimes writes tool calls as plain text
    instead of answering ("<invoke name=Bash>... echo 1, echo 2, ...") and
    never stops. Watching the stream catches that within seconds instead of
    after AI_TIMEOUT, and the same check catches a stream that goes silent.
    Each failure is retried once. Returns a CompletedProcess whose stdout is
    the final answer.
    """
    import selectors
    import threading

    cmd = cmd[:2] + ["--output-format", "stream-json", "--verbose",
                     "--include-partial-messages"] + cmd[2:]
    deadline = time.monotonic() + AI_TIMEOUT
    problem = ""
    for attempt in range(1, attempts + 1):
        proc = subprocess.Popen(cmd, stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                                stderr=subprocess.PIPE, cwd=cwd, env=env)
        errors = []
        threading.Thread(target=lambda: errors.append(
            proc.stderr.read().decode(errors="replace")), daemon=True).start()

        def feed():
            try:
                proc.stdin.write(stdin.encode())
                proc.stdin.close()
            except OSError:
                pass
        threading.Thread(target=feed, daemon=True).start()

        sel = selectors.DefaultSelector()
        sel.register(proc.stdout, selectors.EVENT_READ)
        result, last_data, pending, text, problem = None, time.monotonic(), b"", "", ""
        try:
            while not problem:
                now = time.monotonic()
                if now > deadline:
                    proc.kill()
                    raise subprocess.TimeoutExpired(cmd, AI_TIMEOUT, stderr="".join(errors))
                if now - last_data > AI_STALL:
                    problem = (f"claude stopped sending anything for {AI_STALL // 60} minutes "
                               "(the connection to its servers stalled)")
                    break
                if not sel.select(timeout=5):
                    continue
                chunk = os.read(proc.stdout.fileno(), 65536)
                if not chunk:
                    break
                last_data = time.monotonic()
                *lines, pending = (pending + chunk).split(b"\n")
                for line in lines:
                    try:
                        event = json.loads(line)
                    except ValueError:
                        continue
                    if event.get("type") == "result":
                        result = event
                    delta = (event.get("event") or {}).get("delta") or {}
                    if event.get("type") == "stream_event" and delta.get("type") == "text_delta":
                        text += delta.get("text", "")
                if "<invoke" in text or "<function_calls>" in text:
                    problem = ("claude tried to run commands instead of answering (it has no "
                               "tools here, so it would have looped forever)")
                elif len(text) > AI_MAX_ANSWER:
                    problem = f"claude's answer ran past {AI_MAX_ANSWER:,} characters without ending"
        except BaseException:
            proc.kill()
            raise
        finally:
            sel.close()
        if problem:
            proc.kill()
        proc.wait()

        if not problem:
            ok = result is not None and not result.get("is_error") and proc.returncode == 0
            answer = (result or {}).get("result", "") if ok else ""
            err = "".join(errors) or ("" if ok else str((result or {}).get("result", "")))
            return subprocess.CompletedProcess(cmd, 0 if ok else (proc.returncode or 1),
                                               answer, err)
        if attempt < attempts:
            print(f"==> Stopped: {problem}. Trying once more...\n")
    return subprocess.CompletedProcess(
        cmd, 1, "", f"{problem}, twice in a row. Nothing was saved; try again later.")


def run_ai(tool, model, instructions, content, name, out, closing):
    """Send content to the AI tool (tools disabled, empty folder), print and save the answer."""
    build, env = AI_TOOLS[tool]
    with tempfile.TemporaryDirectory() as tmp:
        data = os.path.join(tmp, "package-files.txt")
        with open(data, "w") as f:
            f.write(content)
        stdin = content if tool != "ollama" else instructions + "\n\n" + content
        if tool == "opencode":
            stdin = ""
        print(f"\n==> Waiting for {tool}'s answer (usually under a minute; "
              "press Ctrl+C to cancel)...\n")
        try:
            if tool == "claude":
                proc = run_claude_watched(build(data, model, instructions), stdin, tmp,
                                          {**os.environ, **env})
            else:
                proc = subprocess.run(build(data, model, instructions), input=stdin, text=True,
                                      cwd=tmp, capture_output=True, env={**os.environ, **env},
                                      timeout=AI_TIMEOUT)
        except subprocess.TimeoutExpired as e:
            print(f"aur-audit ai: {tool} gave no answer within {AI_TIMEOUT // 60} minutes; "
                  "try again later.")
            err = e.stderr.decode(errors="replace") if isinstance(e.stderr, bytes) else e.stderr
            if err and err.strip():
                print(f"Last messages from {tool}:\n{err.strip()[-2000:]}")
            return 1
        except KeyboardInterrupt:
            print(f"\naur-audit ai: cancelled. {tool} may still count what it had already used.")
            return 130
    answer = proc.stdout.strip()
    if proc.returncode != 0 or not answer:
        print(f"aur-audit ai: {tool} failed:\n{proc.stderr.strip()[-2000:]}")
        return 1

    print(answer)
    with open(out, "w") as f:
        f.write(f"AI review of {name} by {tool}{' (' + model + ')' if model else ''} "
                f"on {time.strftime('%Y-%m-%d %H:%M:%S %Z')}\n"
                f"This is an AI opinion, not a guarantee. {closing}\n\n{answer}\n")
    print(f"\n==> AI review saved to {out}")
    print(f"==> {closing}")
    return 0


# ---------------------------------------------------------------- system scan

TEMP_DIRS = ("/tmp", "/var/tmp", "/dev/shm")
SHELL_STARTUP = ["~/.bashrc", "~/.bash_profile", "~/.bash_login", "~/.profile", "~/.zshrc",
                 "~/.zprofile", "~/.zshenv", "~/.zlogin", "~/.config/fish/config.fish"]
KNOWN_BAD = {"atomic-lockfile": "the npm package used in the June 2026 AUR attack"}
# For shell startup files, mentioning .bashrc etc. is normal, so skip that rule.
STARTUP_RULES = [r for r in SCRIPT_RULES if ".bashrc" not in r[1]]


def unit_exec_lines(path):
    try:
        return [l.strip() for l in open(path, errors="replace")
                if re.match(r"\s*Exec\w*=", l)]
    except OSError:
        return []


def in_temp(path):
    return path.startswith(TEMP_DIRS) or "/." in path.replace("/.local/", "/").replace(
        "/.config/", "/").replace("/.cache/", "/")


def system_scan():
    """Gather a security snapshot without root. Returns (sections, ai_bundle)."""
    sections, bundle = [], []
    owned = set(l.rstrip("/") for l in run(["pacman", "-Qlq"]).splitlines())
    home = os.path.expanduser("~")

    # 1. Packages from outside the official repos ------------------------------
    print("==> [1/4] Checking packages installed from the AUR or elsewhere...")
    foreign = run(["pacman", "-Qmq"]).split()
    repo_names = repo_package_names()
    infos = {}
    try:
        for i in range(0, len(foreign), 100):
            infos.update(aur_info(foreign[i:i + 100]))
    except OSError as e:
        print(f"    could not reach the AUR ({e}); reputation checks skipped")
    pkg_reps = []
    for n, name in enumerate(foreign, 1):
        print(f"    ({n}/{len(foreign)}) {name}")
        rep, details = Report(name), []
        version, dbdir = local_db_entry(name)
        rep.version = version
        info = infos.get(name)
        if info:
            check_aur_info(rep, info, repo_names)
            if version != info["Version"]:
                rep.add(INFO, f"installed {version}, AUR has {info['Version']}")
        else:
            rep.add(WARN, "not on the AUR any more (or never was). Packages are deleted from "
                          "the AUR when found to be malicious; find out why this one is gone")
            check_impersonation(rep, name, 0, 0, None, repo_names)
        try:
            install = open(os.path.join(dbdir, "install"), errors="replace").read()
            scan_script(rep, "install script (ran as root):", install, INSTALL_RULES)
            details.append(f"--- install script ---\n{install[:4000]}")
        except OSError:
            pass
        for path in run(["pacman", "-Qlq", name]).splitlines():
            for level, pattern, d in PATH_RULES:
                if re.search(pattern, path.lstrip("/")):
                    rep.add(level, f"package {d}: {path}")
            try:
                st = os.lstat(path)
                if stat.S_ISREG(st.st_mode) and st.st_mode & (stat.S_ISUID | stat.S_ISGID):
                    rep.add(WARN, f"setuid/setgid file: {path}")
            except OSError:
                pass
        cache = os.path.join(home, ".cache/yay", (info or {}).get("PackageBase", name))
        try:
            src = open(os.path.join(cache, ".SRCINFO"), errors="replace").read()
            if srcinfo_version(src) == version:
                pkgbuild = open(os.path.join(cache, "PKGBUILD"), errors="replace").read()
                scan_script(rep, "PKGBUILD", pkgbuild, PKGBUILD_RULES)
                details.append(f"--- PKGBUILD (version installed) ---\n{pkgbuild[:6000]}")
        except OSError:
            pass
        pkg_reps.append((rep, details))
    sections.append(("Packages from the AUR or elsewhere", [r for r, _ in pkg_reps]))
    for rep, details in pkg_reps:
        flagged = any(l in (BLOCK, WARN) for l, _ in rep.findings)
        bundle.append(f"===== package {rep.name} {rep.version} =====\n{format_findings(rep)}"
                      + ("\n" + "\n".join(details) if details and (flagged or len(foreign) <= 30)
                         else ""))

    # 2. Integrity of every installed file -------------------------------------
    print("==> [2/4] Checking every installed file against pacman's records "
          "(about a minute)...")
    rep = Report("integrity")
    check = subprocess.run(["pacman", "-Qkk"], capture_output=True, text=True)
    lines = [l for l in check.stderr.splitlines() if l.startswith("warning:")]
    unreadable = [l for l in lines if "Permission denied" in l or "failed to calculate" in l]
    real = [l for l in lines if l not in unreadable]
    changed = sorted({re.sub(r" \([^)]*\)$", "", l) for l in real
                      if re.search(r"checksum mismatch|Size mismatch", l)})
    other = [l for l in real if re.sub(r" \([^)]*\)$", "", l) not in changed]
    for l in changed:
        path = l.split(": ", 2)[-1]
        program = re.match(r"/(usr/)?(s?bin|lib(32|64)?/[^/]+\.so)", path) or "/bin/" in path
        rep.add(WARN if program else INFO, f"file contents changed since install: {l[9:]}")
    rep.add(INFO, f"{len(other)} permission/owner/type differences, {len(unreadable)} files "
                  "unreadable without root (skipped)")
    sections.append(("Installed files changed since install", [rep]))
    bundle.append("===== pacman -Qkk (all packages), contents changed =====\n"
                  + ("\n".join(changed) or "(none)")
                  + "\n===== other differences =====\n" + ("\n".join(other[:150]) or "(none)")
                  + f"\n({len(unreadable)} files unreadable without root were skipped)")

    # 3. Places malware uses to start itself -----------------------------------
    print("==> [3/4] Checking startup locations (services, autostart, cron, shell)...")
    rep = Report("persistence")
    seen = []
    if os.path.exists("/etc/ld.so.preload"):
        try:
            content = open("/etc/ld.so.preload").read().strip()
        except OSError:
            content = "(unreadable)"
        rep.add(BLOCK, f"/etc/ld.so.preload exists (forces code into every program; "
                       f"rootkit technique): {content[:200]}")
        seen.append(f"/etc/ld.so.preload: {content}")
    for base in ("/etc/systemd/system", "/usr/lib/systemd/system", "/usr/lib/systemd/user",
                 "/etc/systemd/user", os.path.join(home, ".config/systemd/user")):
        for root, _, files in os.walk(base):
            for f in files:
                path = os.path.join(root, f)
                target = os.path.realpath(path)
                if os.path.islink(path):
                    if in_temp(target) or target.startswith("/home/") and "/.config/systemd" not in target:
                        rep.add(BLOCK, f"enabled service points into an unusual place: "
                                       f"{path} -> {target}")
                    continue
                if path in owned or not f.endswith((".service", ".timer", ".socket", ".path")):
                    continue
                execs = unit_exec_lines(path)
                user_unit = path.startswith(home)
                seen.append(f"{path}: " + " | ".join(execs))
                bad = [e for e in execs if in_temp(e.split("=", 1)[-1].split()[0] if "=" in e else e)
                       or re.search(r"curl|wget|base64|/dev/tcp|nc\s", e)]
                if bad:
                    rep.add(BLOCK, f"service runs something suspicious: {path}: {bad[0][:150]}")
                elif not user_unit:
                    rep.add(WARN, f"system service not installed by any package: {path}")
                else:
                    rep.add(INFO, f"your own user service: {path}")
    autostart = [os.path.join(home, ".config/autostart")] + ["/etc/xdg/autostart"]
    for d in autostart:
        for f in sorted(os.listdir(d)) if os.path.isdir(d) else []:
            path = os.path.join(d, f)
            if path in owned:
                continue
            entry = open(path, errors="replace").read()
            if re.search(r"^Hidden\s*=\s*true", entry, re.MULTILINE | re.IGNORECASE):
                continue  # this entry switches an autostart program OFF
            execs = [l.strip() for l in entry.splitlines() if l.startswith("Exec")]
            seen.append(f"{path}: " + " | ".join(execs))
            cmd = " ".join(execs)
            if in_temp(cmd.split("=", 1)[-1].split()[0] if "=" in cmd else "") or \
                    re.search(r"curl|wget|base64|/dev/tcp", cmd):
                rep.add(BLOCK, f"autostart entry runs something suspicious: {path}: {cmd[:150]}")
            else:
                rep.add(INFO, f"autostart entry: {path}: {cmd[:120]}")
    cron = ["/etc/crontab"] + [os.path.join(d, f) for d in ("/etc/cron.d", "/etc/cron.hourly",
            "/etc/cron.daily", "/etc/cron.weekly", "/etc/cron.monthly") if os.path.isdir(d)
            for f in os.listdir(d)]
    for path in cron:
        if os.path.isfile(path) and path not in owned:
            rep.add(WARN, f"cron job not installed by any package: {path}")
            seen.append(f"cron: {path}")
    user_cron = subprocess.run(["crontab", "-l"], capture_output=True, text=True) \
        if shutil.which("crontab") else None
    if user_cron and user_cron.returncode == 0 and user_cron.stdout.strip():
        rep.add(WARN, "your user account has cron jobs (see report)")
        seen.append("user crontab:\n" + user_cron.stdout[:2000])
    startup = [os.path.expanduser(p) for p in SHELL_STARTUP] + \
        [os.path.join("/etc/profile.d", f) for f in sorted(os.listdir("/etc/profile.d"))
         if os.path.join("/etc/profile.d", f) not in owned]
    for path in startup:
        try:
            text = open(path, errors="replace").read()
        except OSError:
            continue
        probe = Report(path)
        scan_script(probe, f"{path}:", text, base_rules=STARTUP_RULES)
        for level, msg in probe.findings:
            rep.add(level, msg)
            seen.append(msg)  # only flagged lines are sent, never whole files (privacy)
    sections.append(("Startup locations", [rep]))
    bundle.append("===== startup locations not installed by packages =====\n"
                  + ("\n".join(seen) or "(none)"))

    # 4. Hidden programs, privilege escalation, known bad --------------------
    print("==> [4/4] Looking for hidden programs and known malware traces...")
    rep = Report("other")
    found = []
    suid = run(["find", "/usr", "/opt", "/etc", "-xdev", "-type", "f", "-perm", "/6000"])
    for path in suid.splitlines():
        if path not in owned:
            rep.add(BLOCK, f"setuid/setgid program not installed by any package: {path}")
            found.append(f"unowned setuid: {path}")
    for d in TEMP_DIRS:
        for path in run(["find", d, "-xdev", "-maxdepth", "3", "-type", "f", "-perm", "/111",
                         "-not", "-path", "*/.mount_*"]).splitlines()[:50]:
            try:
                elf = open(path, "rb").read(4) == b"\x7fELF"
            except OSError:
                elf = False
            rep.add(BLOCK if elf and d == "/dev/shm" else WARN,
                    f"{'program' if elf else 'executable file'} in a temporary folder: {path}")
            found.append(f"temp executable ({'ELF' if elf else 'script'}): {path}")
    for pid in filter(str.isdigit, os.listdir("/proc")):
        try:
            exe = os.readlink(f"/proc/{pid}/exe")
        except OSError:
            continue
        if exe.startswith(TEMP_DIRS):
            rep.add(BLOCK, f"running process {pid} started from a temporary folder: {exe}")
            found.append(f"process {pid}: {exe}")
    for d in ("/usr/bin", "/usr/lib/systemd/system-generators"):
        for f in os.listdir(d) if os.path.isdir(d) else []:
            path = os.path.join(d, f)
            if path not in owned and not os.path.islink(path):
                rep.add(WARN, f"program not installed by any package: {path}")
                found.append(f"unowned: {path}")
    local = sorted(f for f in (os.listdir("/usr/local/bin") if os.path.isdir("/usr/local/bin")
                               else []) if f"/usr/local/bin/{f}" not in owned)
    if local:
        rep.add(INFO, "programs you installed by hand in /usr/local/bin: " + ", ".join(local[:30]))
        found.append("/usr/local/bin: " + ", ".join(local))
    for needle, what in KNOWN_BAD.items():
        hits = run(["grep", "-rlsF", "--include=PKGBUILD", needle,
                    os.path.join(home, ".cache/yay")]).split()
        hits += run(["grep", "-rlsF", "-m1", needle, os.path.join(home, ".npm/_cacache/index-v5")]
                    ).split()[:3]
        for h in hits:
            rep.add(BLOCK, f"trace of {what} ('{needle}'): {h}")
            found.append(f"known-bad '{needle}': {h}")
    rep.add(INFO, "not checked (needs root): eBPF programs (sudo bpftool prog list), "
                  "root's cron jobs, /etc/sudoers.d, files only root can read")
    sections.append(("Hidden programs and known malware traces", [rep]))
    bundle.append("===== other checks =====\n" + ("\n".join(found) or "(nothing found)")
                  + "\nNot checked (needs root): eBPF programs, root crontab, /etc/sudoers.d")
    return sections, "\n\n".join(bundle)


def print_system_report(sections):
    """Print the free scan's results; returns the text and the number of serious findings."""
    out, serious = [], 0
    order = {BLOCK: 0, WARN: 1, INFO: 2}
    names = {BLOCK: "SERIOUS", WARN: "CHECK", INFO: "INFO"}
    for title, reps in sections:
        out.append(f"\n==> {title}")
        for rep in reps:
            shown = [f for f in rep.findings if f[0] != INFO or len(reps) == 1]
            if len(reps) > 1:
                worst = min((order[l] for l, _ in rep.findings), default=2)
                if worst == 2:
                    out.append(f"  {rep.name} {rep.version or ''}: ok")
                    continue
                out.append(f"  {rep.name} {rep.version or ''}:")
            for level, msg in sorted(shown, key=lambda f: order[f[0]]):
                serious += level == BLOCK
                out.append(f"  {'  ' if len(reps) > 1 else ''}[{names[level]}] {msg}")
    text = "\n".join(out)
    print(text)
    return text, serious


def system_command(with_ai=False, assume_yes=False):
    if os.geteuid() == 0:
        print("aur-audit: run this as yourself, not with sudo.")
        return 2
    sections, bundle = system_scan()
    text, serious = print_system_report(sections)
    stamp = time.strftime("%Y-%m-%d_%H-%M-%S")
    report = os.path.expanduser(f"~/aur-audit-system-scan-{stamp}.txt")
    with open(report, "w") as f:
        f.write(f"aur-audit system scan on {time.strftime('%Y-%m-%d %H:%M:%S %Z')}\n"
                "SERIOUS = investigate now, CHECK = worth a look, INFO = background.\n"
                + text + "\n")
    print(f"\n==> {serious} serious finding(s). Report saved to {report}")
    if not with_ai:
        print("==> For a second opinion from your AI assistant: aur-audit ai --system")
        return 1 if serious else 0
    return ai_system_review(bundle, stamp, assume_yes)


def ai_system_review(bundle, stamp, assume_yes):
    tool, model = choose_ai()
    if not tool:
        return 2
    instructions = AI_INTRO_SYSTEM + "\n" + AI_INSTRUCTIONS.split("Check:")[0]
    data = os.path.expanduser(f"~/aur-audit-ai-system-data-{stamp}.txt")
    with open(data, "w") as f:
        f.write(bundle)
    # Roughly 3.5 characters per token for this mix of code and text.
    tokens_in = int((len(instructions) + len(bundle)) / 3.5 / 100 + 1) * 100
    tokens_out = 4000
    local = tool == "ollama"
    print(f"""
==> AI system review with {tool}{' (' + model + ')' if model else ''}
    Data to send:      {len(bundle) / 1024:.0f} KB (exactly what will be sent: {data})
    Estimated usage:   about {tokens_in:,} input tokens + up to {tokens_out:,} output tokens
                       = roughly {tokens_in + tokens_out:,} tokens
    {tool} also adds its own built-in instructions, so real usage will be somewhat higher.
    {"This stays on your computer (Ollama), so it costs nothing but time." if local else
     "This uses your " + tool + " plan's usage or API credits, and sends package names,"
     " file paths, service/startup entries and flagged lines to " + tool + "'s servers."}""")
    if not assume_yes:
        if not sys.stdin.isatty():
            print("Not running interactively; add --yes to confirm.")
            return 2
        if input("\nSend it? [y/N] ").strip().lower() not in ("y", "yes"):
            print("Cancelled. Nothing was sent.")
            return 0
    return run_ai(tool, model, instructions, bundle, "system",
                  os.path.expanduser(f"~/aur-audit-ai-system-review-{stamp}.txt"),
                  "The AI can be wrong. Check its evidence before acting on it.")



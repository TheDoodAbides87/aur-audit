]

# Installing a *named* package from a language registry pulls code nobody reviewed.
# Building from a lockfile ("npm install" / "npm ci" with no package name) is normal.
REGISTRY_INSTALL = re.compile(
    r"\b(?:npm|pnpm|yarn|bun)\s+(?:i|install|add)\b([^\n;&|]*)"
    r"|\b(?:pip3?|pipx|uv\s+pip)\s+install\b([^\n;&|]*)"
    r"|\b(?:cargo|gem)\s+install\b([^\n;&|]*)"
    r"|\bgo\s+install\s+\S+@()")
# Options whose next word is a value (a folder, file or setting), not a package.
VALUE_FLAGS = {
    "--cache", "--prefix", "--include", "--omit", "--registry", "--userconfig",
    "--modules-folder", "--cwd", "--dir", "-C", "--filter", "--workspace", "-w", "--target",
    "--arch", "--platform", "--runtime", "--tag", "--loglevel", "--network-timeout",
    "--mutex", "--cache-folder", "--global-folder", "--dist-url", "--store-dir",
    "--virtual-store-dir", "--path", "--root", "-r", "--requirement", "-c", "--constraint",
    "-i", "--index-url", "--extra-index-url", "-f", "--find-links", "--install-dir", "-n",
    "--bindir", "--git", "--branch", "--rev", "--features", "-F", "--profile", "-j",
    "--jobs", "--config", "--target-dir"}
PACKAGE_WORD = re.compile(r"^@?[a-zA-Z0-9][\w.\-]*(/[\w.\-]+)?([@=<>~^!].*)?$")


def named_registry_install(text):
    """Offset of the first command that installs a named registry package, or None."""
    for m in REGISTRY_INSTALL.finditer(text):
        args = next((g for g in m.groups() if g is not None), "")
        if m.group(0).startswith("go"):
            return m.start()
        skip = False
        for word in args.split():
            if skip:
                skip = False
            elif word.startswith("-"):
                skip = "=" not in word and word in VALUE_FLAGS
            elif ("/" in word and not word.startswith("@")) or "$" in word \
                    or word[0] in "\"'.~" or word.startswith(("http", "git+")):
                continue  # a path, variable or URL, not a registry package
            elif PACKAGE_WORD.match(word):
                return m.start()
    return None



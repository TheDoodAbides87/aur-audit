    (BLOCK, r"\b(ba|z)?sh\s+-c\s+[\"']?\$\((curl|wget)",
     "executes downloaded code"),
    (BLOCK, r"eval\s+[\"']?\$\((curl|wget|echo[^)]*base64)",
     "evals downloaded or encoded code"),
    (BLOCK, r"base64\s+(-d|--decode)[^\n]*\|\s*(ba|z)?sh\b",
     "decodes base64 and runs it as a shell script"),
    (BLOCK, r"python[23]?\s+-c\s+[\"'].*\b(exec|eval|b64decode|urlopen|socket)\b",
     "runs inline Python that execs/decodes/downloads code"),
    (BLOCK, r"/dev/(tcp|udp)/", "opens a raw network socket (reverse-shell technique)"),
    (BLOCK, r"\b(nc|ncat|netcat)\b[^\n]*\s-[ec]\b", "netcat with command execution"),
    (BLOCK, r"/etc/ld\.so\.preload", "touches /etc/ld.so.preload (rootkit technique)"),
    (BLOCK, r"/etc/sudoers", "modifies sudo configuration"),
    (BLOCK, r"\bcrontab\b|/etc/cron|/var/spool/cron", "installs a cron job"),
    (BLOCK, r"authorized_keys", "touches SSH authorized_keys"),
    (BLOCK, r"\b(chpasswd|passwd\s+\w)", "changes account passwords"),
    (BLOCK, r"\brm\s+-[a-zA-Z]*r[a-zA-Z]*\s+(/|~|\$HOME|/home)(\s|$|/\*)",
